  create  table "scrapy_data"."my_dbt_schema"."dim_products__dbt_tmp"
  
  
    as
  
  (
    WITH products_to_dim as (
    SELECT DISTINCT
        MD5(TRIM(LOWER(full_title)) || memory || storage || color) as product_key,
        full_title,
        storage,
