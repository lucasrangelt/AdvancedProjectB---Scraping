  create  table "scrapy_data_aws"."my_dbt_schema"."stg_data__dbt_tmp"
  
  
    as
  
  (
    WITH data_to_stg AS (
    
        SELECT * FROM "scrapy_data_aws"."public"."raw_data"
    
)

SELECT
    CAST(id AS INTEGER) AS id,
    CASE
        WHEN full_title ILIKE '%notebook%' THEN 'notebook'
        ELSE 'other'
    END AS short_title,
    full_title,
    memory,
    storage,
    LOWER(color) AS color,
    CAST(REPLACE(REPLACE(price, '.', ''), ',', '.') AS NUMERIC(10, 2)) AS price,
    scraped_at,
    CASE
        WHEN rating LIKE '%.%' THEN CAST(REGEXP_REPLACE(rating, '[^0-9.]', '', 'g') AS NUMERIC(10, 2))
        ELSE NULL
    END AS rating,
    site_name
FROM
    data_to_stg
  );
  
